{
  "expo": {
    "name": "Ebb",
    "slug": "ebb",
    "scheme": "ebb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0F14",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ebb.calm",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Ebb can use your camera for grounding exercises that ask you to find objects around you. Nothing is recorded, saved, or uploaded.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.ebb.calm",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0F14"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ebb can use your camera for grounding exercises that ask you to find objects around you. Nothing is recorded, saved, or uploaded."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow microphone access so you can record private voice memories and messages for yourself. Recordings stay on this device.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ebb can use Face ID to keep your journal private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
